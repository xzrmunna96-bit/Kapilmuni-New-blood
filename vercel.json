{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/__/auth/:path*", "destination": "https://kapilmunibled.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/init.json", "destination": "https://kapilmunibled.firebaseapp.com/__/firebase/init.json" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=()" },
      { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; form-action 'self'" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/admin(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ]
}
